# .env с тестовыми значениями лежит в git, чтобы стек поднимался сразу
# после pull. Секреты (HF_TOKEN и т. п.) — только в .env.local.
# На сервере .env свой: при обновлении из git его откладывают (docs/release.md).
.env.local

# Веса модели (десятки гигабайт) скачиваются при релизе, в git им
# не место. dist/ — артефакты сборки.
dist/
models/

# Корневой сертификат Keycloak (KEYCLOAK_CA_FILE): у каждого сервера свой.
certs/*
!certs/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/

# macOS
.DS_Store

# Дампы базы перед миграциями (docs/data.md, «Резервная копия» — в backups/)
*.dump
backups/

# Локальное окружение Python
.venv/

# Интерфейс: зависимости и артефакты сборки и тестов
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
# Кэш инкрементальной сборки TypeScript
*.tsbuildinfo

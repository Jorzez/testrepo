// ============================================================
//  Миграция 002 — описания проверяемых атрибутов
//
//  Запуск:
//    docker compose run --rm \
//      -e SEED_FILE=/init/migrations/002_check_target_descriptions.cypher seeder
//
//  Зачем: промпт для модели строится из CheckTarget.description.
//  У атрибута без описания модель получает только имя, без критерия —
//  и системно его не распознаёт. Из-за этого «проект» не был найден
//  в цели, хотя правило R-1.1 отработало и выдало нарушение.
//
//  Описание пишется для читателя-модели: короткое перечисление того,
//  что именно считается признаком присутствия атрибута в тексте цели.
//
//  MERGE по name безопасен: name — уникальный ключ узла.
//  Запускать ПОСЛЕ миграции 001, когда дубли уже сведены.
// ============================================================

MERGE (t:CheckTarget {name: "проект"})
SET t.description = "в цели явно назван проект, программа или инициатива, в рамках которой ведётся работа: 'в рамках проекта X', 'по проекту X'. Название системы, продукта или подразделения само по себе проектом не считается";

MERGE (t:CheckTarget {name: "срок_исполнения"})
SET t.description = "в цели указан проверяемый срок: конкретная дата, месяц, квартал или год ('до 01.06.2025', 'до конца II квартала 2025'). Формулировки без даты — 'в ближайшее время', 'по возможности', 'до конца отчётного периода' — сроком не считаются";

// ------------------------------------------------------------
//  Ниже — шаблон для остальных атрибутов вашей нормативки.
//  Посмотреть, у каких атрибутов описания ещё нет:
//
//    curl -s localhost:8080/ready | python3 -m json.tool
//
//  или в Neo4j Browser:
//
//    MATCH (t:CheckTarget)
//    WHERE t.description IS NULL OR trim(t.description) = ''
//    OPTIONAL MATCH (r:Rule)-[:APPLIES_TO]->(t)
//    RETURN t.name, collect(r.ruleId) AS rules, collect(r.checkInstruction) AS hints;
//
//  checkInstruction правила — хорошая заготовка для описания атрибута.
//
//  MERGE (t:CheckTarget {name: "обучающий_материал"})
//  SET t.description = "...";

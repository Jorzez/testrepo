// ============================================================
//  Миграция 001 — убрать демонстрационные данные
//
//  Запуск:
//    docker compose run --rm \
//      -e SEED_FILE=/init/migrations/001_cleanup_demo_data.cypher seeder
//
//  Что делает:
//    1. Удаляет демо-приказы ПР-2024-15 и ПР-2024-22 со всеми
//       пунктами, правилами и примерами. Рабочий набор — ПР-01.
//    2. Удаляет примеры, оставшиеся без правила.
//
//  Двойники атрибутов («срок исполнения» / «срок_исполнения» — из-за
//  такой пары правило R-2.4 срабатывало как невыполненное) этот скрипт
//  больше не сводит: приближённая нормализация на Cypher расходилась с
//  naming.normalize_name, а шаг «удалить атрибуты без правил» сносил и
//  атрибуты, заведённые заранее. Сводит их API той же нормализацией,
//  что агент и диагностика, и удаляет только сведённые узлы:
//    POST /catalog/merge-duplicate-targets   (роль администратора)
//
//  Повторный запуск ничего не меняет: удаляемых узлов уже нет.
//  ВНИМАНИЕ: шаг 1 удаляет узлы. Сделайте дамп базы перед запуском
//  (см. docs/deployment.md, раздел о резервной копии).
// ============================================================

// ---------- 1. Демонстрационные приказы ----------
MATCH (o:Order)
WHERE o.orderId IN ["PR-2024-15", "PR-2024-22"]
OPTIONAL MATCH (o)-[:CONTAINS]->(c:Clause)
OPTIONAL MATCH (c)-[:DEFINES]->(r:Rule)
OPTIONAL MATCH (r)-[:HAS_EXAMPLE]->(e:ViolationExample)
DETACH DELETE e, r, c, o;

// ---------- 2. Осиротевшие примеры ----------
MATCH (e:ViolationExample)
WHERE NOT (:Rule)-[:HAS_EXAMPLE]->(e)
DETACH DELETE e;

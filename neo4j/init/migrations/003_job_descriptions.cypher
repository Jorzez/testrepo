// ============================================================
//  Миграция 003: должностные инструкции и правило пункта 3.5
//
//  Пункт 3.5: цель не должна дублировать должностные обязанности
//  сотрудника. По одному тексту цели это не определить, поэтому атрибут
//  помечен source = "job_descriptions": агент сравнивает цель с
//  должностными инструкциями подразделения (api/agent.py), а описание
//  атрибута служит критерием сравнения.
//
//  Что делает:
//    1. Создаёт ограничение уникальности для :JobDescription.
//    2. Заводит атрибут «дублирование_должностных_обязанностей».
//    3. Если в базе есть пункт 3.5 без правил — заводит под ним запрет
//       R-3.5 на этом атрибуте. Если пункта нет или правило у него уже
//       есть, заведите правило мастером: тип «Запрет», атрибут — этот.
//
//  Сами инструкции загружаются в интерфейсе: «Подразделения» →
//  меню подразделения → «Добавить должностную инструкцию».
//
//  Скрипт идемпотентен. Запуск:
//      docker compose run --rm \
//        -e SEED_FILE=/init/migrations/003_job_descriptions.cypher seeder
// ============================================================

CREATE CONSTRAINT job_description_id IF NOT EXISTS
FOR (j:JobDescription) REQUIRE j.jobDescriptionId IS UNIQUE;

MERGE (t:CheckTarget {name: "дублирование_должностных_обязанностей"})
ON CREATE SET t.status = "active"
SET t.source = "job_descriptions",
    t.description = coalesce(t.description, "цель повторяет обязанность из должностной инструкции: её выполнение — та же работа, которую сотрудник и так обязан делать по инструкции, без нового результата, показателя или изменения сверх обычных обязанностей");

// Пунктов 3.5 может быть несколько (в разных приказах) — правило получит
// только действующий пункт, у которого правил ещё нет.
MATCH (c:Clause {code: "3.5"})
WHERE coalesce(c.status, "active") = "active"
  AND NOT (c)-[:DEFINES]->(:Rule)
  AND NOT EXISTS { MATCH (:Rule {ruleId: "R-3.5"}) }
WITH c ORDER BY c.clauseId LIMIT 1
MATCH (t:CheckTarget {name: "дублирование_должностных_обязанностей"})
CREATE (r:Rule {ruleId: "R-3.5", type: "PROHIBITION", status: "active",
                description: "Цель не должна дублировать должностные обязанности сотрудника",
                checkInstruction: "Сформулируйте цель как результат сверх обычных обязанностей: новый показатель, изменение, проект. Выполнение того, что и так записано в должностной инструкции, целью не является."})
CREATE (c)-[:DEFINES]->(r)
CREATE (r)-[:APPLIES_TO]->(t);

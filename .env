# Тестовое окружение: файл лежит в git, чтобы стек поднимался сразу после pull.
# Секреты сюда не класть — HF_TOKEN и прочее держите в .env.local (он в .gitignore).
# Для боевого сервера задайте свои значения.

NEO4J_PASSWORD=password123
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_MODEL_DIR=Qwen3-8B
MODELS_DIR=./models
VLLM_IMAGE=vllm/vllm-openai:v0.9.2
APP_VERSION=latest

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
BULK_MAX_WORKERS=4
MAX_GOALS_PER_REQUEST=200
LOG_LEVEL=INFO

# --- Вход в интерфейс (стенд) -------------------------------------------------
# На стенде каталога (LDAP/AD) нет, поэтому пароль проверяется по записи ниже.
# Учётка стенда: логин admin, пароль stand-Hv5P7EjJ
# На боевом сервере — AUTH_BACKEND=ldap и свои LDAP_URL / LDAP_USER_TEMPLATE,
# см. .env.example. Новая запись: docker compose run --rm api python auth.py hash
AUTH_BACKEND=static
AUTH_STATIC_USERS=admin:pbkdf2:600000:ea55b91cfbe7c0b42d42968ba1b9f0bc:21802cd4c790382d2b57394cb133728bbe0dbc2af802222128689f55cd7a1030
AUTH_ADMIN_LOGINS=admin
# Стенд открывают по HTTP, в том числе не с localhost: cookie без флага Secure.
SESSION_COOKIE_SECURE=0
# Swagger: http://localhost:8080/docs (только с самого сервера).
ENABLE_DOCS=1

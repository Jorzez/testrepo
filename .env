# Тестовое окружение: файл лежит в git, чтобы стек поднимался сразу после pull.
# Секреты сюда не класть — HF_TOKEN и прочее держите в .env.local (он в .gitignore).
# Для боевого сервера задайте свои значения.

NEO4J_PASSWORD=password123
VLLM_MODEL=Qwen/Qwen3.6-27B-FP8
VLLM_MODEL_DIR=Qwen3.6-27B-FP8
MODELS_DIR=./models
VLLM_IMAGE=vllm/vllm-openai:v0.30.0
APP_VERSION=latest

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
BULK_MAX_WORKERS=4
MAX_GOALS_PER_REQUEST=200
LOG_LEVEL=INFO

# --- Вход в интерфейс (стенд) -------------------------------------------------
# Вход через Keycloak. На стенде он поднимается из compose (профиль idp) с
# realm-ом из keycloak/realm-goal-checker.json: учётка стенда — логин admin,
# пароль stand-Hv5P7EjJ. Консоль Keycloak: http://localhost:8180, логин admin,
# пароль KEYCLOAK_ADMIN_PASSWORD. Консоль и интерфейс стенда слушают только
# 127.0.0.1: пароли стенда лежат в git. На боевом сервере — адрес
# корпоративного Keycloak и без профиля idp, см. .env.example.
COMPOSE_PROFILES=idp
WEB_BIND=127.0.0.1
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.3
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=goal-checker
KEYCLOAK_CLIENT_ID=goal-checker-web
KEYCLOAK_ADMIN_PASSWORD=stand-admin-Hv5P7EjJ
AUTH_ADMIN_LOGINS=admin
# Swagger: http://localhost:8080/docs (только с самого сервера).
ENABLE_DOCS=1

# Шаблон для боевого сервера: скопируйте в .env и заполните.
# В репозитории лежит .env с тестовыми значениями; секреты — в .env.local.

# Пароль Neo4j (обязателен).
NEO4J_PASSWORD=change_me

# Имя, под которым модель видна через OpenAI-совместимый API vLLM.
# Именно это значение использует сервис api.
VLLM_MODEL=Qwen/Qwen3-8B

# Каталог с весами внутри ${MODELS_DIR}. Обычно последний сегмент VLLM_MODEL.
VLLM_MODEL_DIR=Qwen3-8B

# Где на хосте лежат веса моделей (внутрь контейнера монтируется как /models).
MODELS_DIR=./models

# Образ vLLM. Тег должен совпадать с тем, что вошёл в офлайн-набор.
VLLM_IMAGE=vllm/vllm-openai:v0.9.2

# Тег образа API, собранного prepare.sh и загруженного install.sh.
APP_VERSION=latest

# --- Вход в интерфейс --------------------------------------------------------
# Пароль проверяет каталог (LDAP/AD): API подключается к нему именем и паролем
# самого пользователя. Роли назначаются в интерфейсе, раздел «Пользователи».

# Адрес каталога. Только ldaps:// (или ldap:// вместе с LDAP_STARTTLS=1):
# без шифрования API к каталогу не подключается.
LDAP_URL=ldaps://dc.example.local:636

# Имя, под которым пользователь подключается к каталогу; {login} — то, что
# введено в форме. Для Active Directory — UPN: {login}@домен.
LDAP_USER_TEMPLATE={login}@example.local

# Корневой сертификат домена: положите файл в ./certs рядом с compose.
# Если не задан, используются системные корневые сертификаты образа.
# LDAP_CA_FILE=/certs/domain-ca.pem

# Логины, которые всегда администраторы (через запятую). Нужен хотя бы один:
# иначе первому пользователю некому назначить роль.
AUTH_ADMIN_LOGINS=change_me

# Адрес или подсеть прокси, на котором завершается TLS: из его X-Forwarded-For
# берётся адрес клиента для журнала аудита и ограничения перебора паролей.
# TRUSTED_PROXY=10.0.0.5

# Необязательные настройки. Помеченные «в интерфейсе» задают значение по
# умолчанию: после правки в разделе «Настройки» действует сохранённое там.
# LLM_TIMEOUT_SECONDS=60
# LOG_LEVEL=INFO
# BULK_MAX_WORKERS=16         # потоков на один пакет целей
# LLM_MAX_CONCURRENCY=32      # одновременных запросов к модели на весь сервис
# LLM_INTERACTIVE_RESERVE=4   # из них недоступно пакетной проверке — для ручных
# CHECK_CACHE_TTL_SECONDS=3600  # сколько помнить ответ на ту же цель; 0 — не помнить (в интерфейсе)
# VLLM_MAX_MODEL_LEN=16384    # окно модели в токенах; больше окно — больше памяти GPU на запрос
# JOB_TEXT_MAX_CHARS=24000    # символов инструкций в одном запросе; должно помещаться в окно
# LLM_JSON_MODE=1             # ответ модели по JSON-схеме; 0 — разбор свободного текста
# CHECK_RATE_PER_MINUTE=600   # целей в минуту на пользователя или ключ доступа; 0 — без ограничения (в интерфейсе)
# PROMPT_EXAMPLES_PER_KIND=2  # примеров «есть» и «нет» на атрибут в промпте (в интерфейсе)
# HISTORY_RETENTION_DAYS=365  # срок хранения истории проверок; 0 — не удалять (в интерфейсе)
# SESSION_IDLE_MINUTES=30     # выход после простоя
# SESSION_MAX_HOURS=12        # предельный срок сессии
# LOGIN_MAX_ATTEMPTS=5        # неудачных входов подряд до блокировки логина
# LOGIN_LOCK_MINUTES=15
# SESSION_COOKIE_SECURE=1     # 0 — только для стенда, открытого по HTTP
# ENABLE_DOCS=0               # 1 — включить Swagger на localhost:8080/docs

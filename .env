# Тестовое окружение: файл лежит в git, чтобы стек поднимался сразу после pull.
# Секреты сюда не класть — HF_TOKEN и прочее держите в .env.local (он в .gitignore).
# Для боевого сервера задайте свои значения.

NEO4J_PASSWORD=password123
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_MODEL_DIR=Qwen3-8B
MODELS_DIR=./models
VLLM_IMAGE=vllm/vllm-openai:v0.9.2
APP_VERSION=latest

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
BULK_MAX_WORKERS=4
MAX_GOALS_PER_REQUEST=200
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

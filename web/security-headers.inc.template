# Заголовки безопасности. Отдельным файлом, потому что add_header внутри
# location отменяет все унаследованные с уровня server: каждый location со
# своим add_header подключает этот файл заново (include).
#
# Шаблон: при старте контейнера nginx подставляет ${KEYCLOAK_CSP_SOURCE} и
# кладёт результат в /etc/nginx/conf.d/security-headers.inc (не *.conf, чтобы
# nginx.conf не подключил его на уровне http). KEYCLOAK_CSP_SOURCE — origin
# Keycloak без пути, его вычисляет /docker-entrypoint.d/16-keycloak-csp.envsh
# из KEYCLOAK_URL.
#
# Страница не встраивается во фреймы и грузит скрипты только со своего
# origin. 'unsafe-inline' у стилей нужен React-атрибутам style, data: —
# значку страницы. Запросы страница шлёт только своему origin и в Keycloak
# (обмен кода на токен, обновление токена). HSTS действует, когда страница
# открыта по HTTPS.
add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${KEYCLOAK_CSP_SOURCE}; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
add_header X-Frame-Options DENY always;
add_header X-Content-Type-Options nosniff always;
add_header Referrer-Policy no-referrer always;
add_header Strict-Transport-Security "max-age=31536000" always;
